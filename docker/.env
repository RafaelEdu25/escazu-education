# ══════════════════════════════════════════════════════════════
#  PEGA ESTO EN: Dokploy → tu servicio Compose → Environment
#  Ajusta los valores marcados con  ← CAMBIA ESTO
# ══════════════════════════════════════════════════════════════

# Imagen
IMAGE_NAME=docker.io/frappe/erpnext
VERSION=version-16
PULL_POLICY=always
APP_BRANCH=version-16

# Sitio Frappe
SITE_NAME=escazu.internal.edupan.dev
ADMIN_PASSWORD="#$P4r4Admin"

# Apps a instalar (no cambiar si usas erpnext + education)
INSTALL_APP_ARGS=--install-app erpnext --install-app education

# App Education
INSTALL_EDUCATION=1
EDUCATION_REPO=https://github.com/DevOpsEdupan/escazu-education

# Base de datos
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=#$C0st4R1c4

# Redis
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# Nginx
FRAPPE_SITE_NAME_HEADER=$host
UPSTREAM_REAL_IP_ADDRESS=0.0.0.0/0

# Gunicorn
GUNICORN_WORKERS=2

# ── JOBS ONE-OFF ───────────────────────────────────────────────
# FLUJO PRIMERA INSTALACIÓN:
#   Paso 1 → pon CONFIGURE=1,  despliega, espera que termine, pon CONFIGURE=0
#   Paso 2 → pon CREATE_SITE=1, despliega, espera que termine, pon CREATE_SITE=0
#   Paso 3 → deploy normal (todo en 0) → stack completo arriba
#
# FLUJO UPGRADE:
#   Pon MIGRATE=1, despliega, espera que termine, pon MIGRATE=0, redeploy
# ──────────────────────────────────────────────────────────────
CONFIGURE=1
CREATE_SITE=0
MIGRATE=0